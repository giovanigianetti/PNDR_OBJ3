{
  "name": "pndr-objetivo-3",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "vite build && python scripts/optimize_data.py",
    "process:data": "python scripts/prepare_public.py && python scripts/process_data.py && python scripts/process_migration.py",
    "check": "tsc --noEmit",
    "process:maps": "python scripts/prepare_public.py && python scripts/local_shapes.py",
    "test": "node scripts/test-migration.mjs && node scripts/test-optimized.mjs && python scripts/audit.py",
    "release": "npm run check && npm run build && python scripts/build-release.py",
    "prebuild": "python scripts/prepare_public.py",
    "predev": "python scripts/prepare_public.py && python scripts/optimize_data.py --public --keep-raw",
    "pretest": "python scripts/prepare_public.py"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "lucide-react": "^1.31.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "tw-animate-css": "^1.4.0"
  }
}
